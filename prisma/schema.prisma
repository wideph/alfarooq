generator client {
  provider = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id              String   @id @default(cuid())
  email           String   @unique
  password        String
  name            String
  role            String   @default("admin")
  permissions     String   @default("[]")
  isActive        Boolean  @default(true)
  createdByAdmin  String?
  lastLoginAt     DateTime?
  createdAt       DateTime @default(now())
  // Office module: booking_office users belong to one BookingOffice.
  bookingOfficeId String?
  bookingOffice   BookingOffice? @relation(fields: [bookingOfficeId], references: [id], onDelete: SetNull)
  officeMember    BookingOfficeMember?
  notifications   Notification[]
  ledgerEntries   LedgerEntry[]
  departmentCommissionRules DepartmentCommissionRule[]
  departmentCommissionSetting DepartmentCommissionSetting?
  remarkDones               CaseRemarkDone[]
  caseReads                 CaseRead[]

  @@index([bookingOfficeId])
}

model Course {
  id            String         @id @default(cuid())
  title         String
  description   String
  thumbnail     String?
  isPublished   Boolean        @default(true)
  order         Float          @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  samples       Sample[]
  questions     Question[]
  userQuestions UserQuestion[]
  botTraining   BotTrainingEntry[]
  botChats      BotConversation[]
}

model SiteSettings {
  id              String   @id @default("site")
  siteName        String   @default("Alfarooq Services")
  logoFilename    String?
  heroText        String   @default("")
  whatsappNumber  String   @default("")
  metaPixelId     String   @default("")
  metaAccessToken String   @default("")
  googleAdsTagId  String   @default("")
  tiktokPixelId   String   @default("")
  botEnabled      Boolean  @default(false)
  botProvider     String   @default("openai")
  botModel        String   @default("")
  botApiKey       String   @default("")
  botSystemNote   String   @default("")
  updatedAt       DateTime @updatedAt
}

model UserQuestion {
  id                   String    @id @default(cuid())
  courseId             String
  question             String
  whatsappNumber       String?
  answer               String?
  answerMediaFilename  String?
  answerMediaType      String?
  status               String    @default("pending")
  source               String    @default("user")
  publishForUsers      Boolean   @default(true)
  trainingOnly         Boolean   @default(false)
  visitorId            String?
  botConversationId    String?
  order                Float     @default(0)
  createdAt            DateTime  @default(now())
  answeredAt           DateTime?
  course               Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  visitor              Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
}

model Sample {
  id        String   @id @default(cuid())
  courseId  String
  title     String
  type      String
  filename  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Question {
  id                  String   @id @default(cuid())
  courseId            String
  question            String
  answer              String
  answerMediaFilename String?
  answerMediaType     String?
  order               Float    @default(0)
  createdAt           DateTime @default(now())
  course              Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model Visitor {
  id               String            @id @default(cuid())
  visitorKey       String            @unique
  source           String?
  medium           String?
  campaign         String?
  referrer         String?
  landingPage      String?
  currentPath      String?
  userAgent        String?
  ipAddress        String?
  status           String            @default("visitor")
  timeSpentSeconds Int               @default(0)
  firstSeenAt      DateTime          @default(now())
  lastSeenAt       DateTime          @default(now())
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  events           VisitorEvent[]
  botChats         BotConversation[]
  userQuestions    UserQuestion[]

  @@index([ipAddress])
  @@index([status, ipAddress])
}

model VisitorEvent {
  id             String   @id @default(cuid())
  visitorId      String
  eventName      String
  status         String?
  payload        Json?
  sentToMeta     Boolean  @default(false)
  sentToGoogle   Boolean  @default(false)
  sentToTikTok   Boolean  @default(false)
  error          String?
  createdAt      DateTime @default(now())
  visitor        Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
}

model BotTrainingEntry {
  id           String    @id @default(cuid())
  courseId     String
  question     String
  answer       String
  source       String    @default("admin")
  sourceRef    String?
  reviewStatus String    @default("approved")
  evidence     Json?
  confidence   Float?
  usageCount   Int       @default(0)
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, source])
  @@index([courseId, reviewStatus])
}

model BotConversation {
  id         String       @id @default(cuid())
  visitorId String?
  courseId  String?
  isPinned   Boolean      @default(false)
  expiresAt  DateTime
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  visitor    Visitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  course     Course?      @relation(fields: [courseId], references: [id], onDelete: SetNull)
  messages   BotMessage[]
}

model BotMessage {
  id             String          @id @default(cuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime        @default(now())
  conversation   BotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Office module (cases / payments / commissions). See docs/office-module/.
// Enum-like columns are TEXT with app-level validation (codebase convention).
// Money is Decimal(12,2). Files for this module live in Cloudflare R2.
// ---------------------------------------------------------------------------

model BookingOffice {
  id          String   @id @default(cuid())
  name        String
  // FIXED_COMMISSION | PROFIT_SHARE | SALARY
  type        String
  phone       String?
  notes       String?
  // §W51: FIXED_COMMISSION office ka rule — case expenses ka kitna % commission
  // member ke account se minus (default 0 = koi nahi). Case bante waqt
  // Case.expenseDeductPercent mein likh diya jata hai (sirf naye cases par asar).
  expenseDeductPercent Decimal @default(0) @db.Decimal(5, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         Admin[]
  members       BookingOfficeMember[]
  commissions   BookingOfficeCommission[]
  cases         Case[]
  ledger        LedgerEntry[]
  salaries      SalaryEntry[]
  expenses      OfficeExpense[]
  bonusRequests BonusRequest[]
  payoutRequests PayoutRequest[]
}

model BookingOfficeMember {
  id              String   @id @default(cuid())
  bookingOfficeId String
  adminId         String?  @unique
  name            String
  profitPercent   Decimal  @default(0) @db.Decimal(5, 2)
  monthlySalary   Decimal  @default(0) @db.Decimal(12, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())

  bookingOffice   BookingOffice @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  admin           Admin?        @relation(fields: [adminId], references: [id], onDelete: SetNull)
  ledger          LedgerEntry[]
  salaries        SalaryEntry[]
  officeExpenses  OfficeExpense[]
  payoutRequests  PayoutRequest[]
  commissionCases Case[]        @relation("CaseCommissionMember")

  @@index([bookingOfficeId])
}

model BookingOfficeCommission {
  id              String  @id @default(cuid())
  bookingOfficeId String
  categoryId      String
  amount          Decimal @db.Decimal(12, 2)

  bookingOffice   BookingOffice @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  category        CaseCategory  @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([bookingOfficeId, categoryId])
}

model CaseCategory {
  id            String   @id @default(cuid())
  name          String   @unique
  defaultAmount Decimal? @db.Decimal(12, 2)
  order         Float    @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  cases         Case[]
  commissions   BookingOfficeCommission[]
  sets          CategorySet[]
  departmentCommissionRules DepartmentCommissionRule[]
}

// Wave 21: department commission rules — per admin × category (× set).
// setId "" = category-wide default (whole category); kisi specific set ke liye
// rule ho to setId us set ki id hoti hai. printAmount / attestationAmount se
// DEPT_COMMISSION ledger entries banti hain (dept-commission.ts).
model DepartmentCommissionRule {
  id                String   @id @default(cuid())
  adminId           String
  categoryId        String
  setId             String   @default("")
  printAmount       Decimal  @default(0) @db.Decimal(12, 2)
  attestationAmount Decimal  @default(0) @db.Decimal(12, 2)
  // §W30: courier department commission (courier slip → DELIVERED).
  courierAmount     Decimal  @default(0) @db.Decimal(12, 2)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  admin    Admin        @relation(fields: [adminId], references: [id], onDelete: Cascade)
  category CaseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([adminId, categoryId, setId])
}

// §W31 — dept user ki per-user (category se azad) commission settings:
// courierAmount = har delivered case (courier slip) par ek hi raqam.
model DepartmentCommissionSetting {
  id            String   @id @default(cuid())
  adminId       String   @unique
  courierAmount Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
}

model AttestationType {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Float    @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  caseAttestations CaseAttestation[]
}

model CaseCounter {
  year Int @id
  last Int @default(0)
}

model Case {
  id                       String    @id @default(cuid())
  caseNumber               String    @unique
  bookingOfficeId          String
  createdByAdminId         String
  categoryId               String?
  clientName               String
  rollNumber               String?
  registrationNumber       String?
  agreedAmount             Decimal   @default(0) @db.Decimal(12, 2)
  claimedRemaining         Decimal?  @db.Decimal(12, 2)
  // NONE | PENDING | ACCEPTED
  claimedRemainingStatus   String    @default("NONE")
  commissionAmount         Decimal   @default(0) @db.Decimal(12, 2)
  commissionHalfCreditedAt DateTime?
  commissionFullCreditedAt DateTime?
  extraSharePercent        Decimal?  @db.Decimal(5, 2)
  extraShareCreditedAt     DateTime?
  profitFinalizedAt        DateTime?
  // WAVE 11 status flow: FIRST_PAYMENT_PENDING | WAITING_FOR_FILE |
  // WAITING_FOR_PRINTING | PRINTED | ATTESTATION (currentAttestationId) |
  // ATTESTATION_COMPLETE | WAITING_FOR_COURIER | DELIVERED |
  // MUSADIQA_APPLIED | MUSADIQA_FEES_PAID | MUSADIQA_SENT_BY_BOARD |
  // MUSADIQA_VERIFIED | CANCELLED
  status                   String    @default("FIRST_PAYMENT_PENDING")
  // Attestation phase pointer — status=ATTESTATION ke waqt current step.
  currentAttestationId     String?
  // §W11.9: booking office ko filing department ki files sirf tab dikhen jab
  // admin ne is case par permission di ho. Baqi departments ki files hamesha.
  filingFilesVisibleToBooking Boolean @default(false)
  // W12: profit-share percent snapshot — pehli distribution ke waqt members ke
  // percents freeze ho jate hain. Admin panel se percent change SIRF naye cases
  // par apply hota hai; purane cases ka distribution nahi badalta. Code-formula
  // correction ke waqt script snapshot clear kar ke recompute karti hai.
  profitShareSnapshot        Json?
  isPrinted                Boolean   @default(false)
  printedAt                DateTime?
  expectedPrintingDate     DateTime?
  // Wave 2 (docs/office-module/06_NEW_REQUIREMENTS.md)
  setId                    String?
  isUrgent                 Boolean   @default(false)
  clientPictureKey         String?
  clientPictureType        String?
  agreedAmountRemarks      String?
  courierNumber            String?
  boardAttestationNumber   String?
  // Wave 21: board/case online verification tracking number (manual entry).
  onlineVerificationNumber String?
  // §W44: admin ka custom label (case page + cases list par nazar aata hai).
  customLabel              String?
  customLabelColor         String?
  // §W44: department commission kitni dafa dena hai per kind
  // ({ PRINTING: 2, ... }); null / kind na ho = 1. Admin status peeche kare
  // (kaam dobara) to har dafa poochta hai — "Haan" par +1.
  deptCommissionRounds     Json?
  // §W45: commission office ka case office ke member ke ilawa (admin / cashier)
  // banaye to admin ka faisla: FULL | NONE | PARTIAL (null = member ne banaya,
  // grid ka poora commission) aur commission kis member ke account mein jaye.
  commissionMode           String?
  commissionMemberId       String?
  // §W51: case bante waqt office ka expense rule (BookingOffice.expenseDeductPercent)
  // — is case ke expenses ka kitna % commission se minus. Purane cases 0.
  expenseDeductPercent     Decimal   @default(0) @db.Decimal(5, 2)
  // §W56: extra services ki kul amount (agreedAmount mein shamil). Asal
  // (initial) agreed = agreedAmount − extraServicesAmount — commission office
  // ki poori commission isi asal par (service se commission wapas nahi hoti).
  extraServicesAmount      Decimal   @default(0) @db.Decimal(12, 2)
  // §W56: dobara kaam (admin "haan" / reissue / extra attestation) ka department
  // commission kis credit number se "case ka kharcha" bhi ({ PRINTING: 2 }) —
  // us credit ka CaseExpense (kind DEPT_COMMISSION) banta hai.
  deptCommissionChargeFrom Json?
  // §W56: reissue par filing dobara — is waqt ke baad wali pehli filing file
  // case ko printing par bhejti hai.
  filingRoundAt            DateTime?
  // §W61: dates ka online check chal raha hai (is waqt tak) — do check saath na chalen.
  datesCheckingUntil       DateTime?
  notes                    String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  bookingOffice    BookingOffice     @relation(fields: [bookingOfficeId], references: [id])
  commissionMember BookingOfficeMember? @relation("CaseCommissionMember", fields: [commissionMemberId], references: [id], onDelete: SetNull)
  category         CaseCategory?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  set              CategorySet?      @relation(fields: [setId], references: [id], onDelete: SetNull)
  contacts         CaseContact[]
  addresses        CaseAddress[]
  attestations     CaseAttestation[]
  payments         Payment[]
  expenses         CaseExpense[]
  ledger           LedgerEntry[]
  files            CaseFile[]
  remarks          CaseRemark[]
  reads            CaseRead[]
  discountRequests DiscountRequest[]
  bonusRequests    BonusRequest[]
  services         CaseService[]
  extraTranches    ExtraShareTranche[]

  @@index([bookingOfficeId, status])
  @@index([bookingOfficeId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@index([rollNumber])
  @@index([registrationNumber])
  @@index([boardAttestationNumber])
}

model CaseContact {
  id        String   @id @default(cuid())
  caseId    String
  phone     String
  label     String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseAddress {
  id        String   @id @default(cuid())
  caseId    String
  address   String
  label     String?
  createdAt DateTime @default(now())
  case      Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model CaseAttestation {
  id                String    @id @default(cuid())
  caseId            String
  attestationTypeId String
  // PENDING | IN_PROGRESS | DONE
  status            String    @default("PENDING")
  scheduledDate     DateTime?
  completedDate     DateTime?
  notes             String?
  order             Float     @default(0)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  case            Case            @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attestationType AttestationType @relation(fields: [attestationTypeId], references: [id])

  @@unique([caseId, attestationTypeId])
}

model Payment {
  id            String    @id @default(cuid())
  caseId        String
  amount        Decimal   @db.Decimal(12, 2)
  paymentDate   DateTime
  // CASH | BANK | EASYPAISA | JAZZCASH | OTHER
  method        String    @default("CASH")
  reference     String?
  slipKey       String?
  slipType      String?
  // PENDING | RECEIVED | NOT_RECEIVED | BOGUS
  status        String    @default("PENDING")
  submittedById String
  verifiedById  String?
  verifiedAt    DateTime?
  remarks       String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  case   Case          @relation(fields: [caseId], references: [id], onDelete: Cascade)
  ledger LedgerEntry[]

  @@index([caseId])
  @@index([caseId, status])
  @@index([status])
  @@index([paymentDate])
}

model CaseExpense {
  id          String   @id @default(cuid())
  caseId      String
  amount      Decimal  @db.Decimal(12, 2)
  description String
  expenseDate DateTime
  // Wave 21 (F3): FIXED_COMMISSION office ho aur flag on ho to expense ka
  // DEBIT case ke commission member ke ledger se kat-ta hai (EXPENSE entry).
  deductFromCommission Boolean @default(false)
  // §W51: admin ka is expense par faisla — kitna % commission se minus
  // (null = case ka rule, Case.expenseDeductPercent). deductFromCommission
  // isi ke saath sync rehta hai (effective % > 0).
  commissionDeductPercent Decimal? @db.Decimal(5, 2)
  // §W51: COURIER = courier department ka kharcha (slip ke saath); null = aam.
  // §W55: BYKEA = courier department ka Bykea kharcha (case ka expense, magar
  // user ki wapsi "Other expenses" hisaab mein).
  kind        String?
  // §W51: department user jis ne apni jeb se diya — admin ne wapas dena hai
  // (DeptPayoutRequest COURIER_EXPENSE). null = company ne khud diya.
  paidByAdminId String?
  // §W56: kind DEPT_COMMISSION — dobara kaam ka department commission jo case ka
  // kharcha bhi hai (us ki DEPT_COMMISSION ledger row). Partner pool aur finance
  // mein ledger row hi ginti hoti hai (ye row wahan nahi — double nahi); sirf
  // commission office ke rule / admin % se member par minus aur case par nazar.
  deptLedgerEntryId String?
  createdById String
  createdAt   DateTime @default(now())
  case        Case     @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([expenseDate])
  @@index([paidByAdminId])
  @@index([deptLedgerEntryId])
}

// §W56 — booking office ki "extra service" (case banne ke baad): ek booking mein
// kai hissay, ek amount (Case.agreedAmount + extraServicesAmount mein judti hai).
//   reissue     — case dobara filing → printing → (attestation) → courier;
//                 printing / courier commission dobara (case ka kharcha).
//   attestationIds — CaseAttestation ids jo is service ne naye / dobara banaye.
//   musadiqa    — musadiqaStatus APPLIED → ATTESTED (admin), commission nahi.
//   customName  — admin ko remark; admin "<naam> Complete" (customDoneAt).
model CaseService {
  id               String    @id @default(cuid())
  caseId           String
  name             String
  amount           Decimal   @db.Decimal(12, 2)
  reissue          Boolean   @default(false)
  reissueDoneAt    DateTime?
  attestationIds   Json?
  musadiqa         Boolean   @default(false)
  // APPLIED | ATTESTED (null = musadiqa hissa nahi)
  musadiqaStatus   String?
  musadiqaDoneAt   DateTime?
  customName       String?
  customDoneAt     DateTime?
  remarks          String?
  imageKey         String?
  imageType        String?
  // ACTIVE | CANCELLED
  status           String    @default("ACTIVE")
  createdById      String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([musadiqaStatus])
}

// §W56 — commission office: extra payment (received − agreed) ka har faisla ek
// tukra. extraAmount = is faisle mein kitni extra raqam, shareAmount = us mein se
// office ko (Rs), receivedAt = faisle ke waqt kul received. Tay shuda tukra baad
// mein service se agreed barhne par dobara nahi khulta; sirf payment wapas hone
// (received < receivedAt) par us ka hissa usi nisbat se kam hota hai. Nayi extra
// (extra − tay shuda) par naya faisla.
model ExtraShareTranche {
  id           String   @id @default(cuid())
  caseId       String
  extraAmount  Decimal  @db.Decimal(12, 2)
  shareAmount  Decimal  @db.Decimal(12, 2)
  // PERCENT | AMOUNT
  mode         String
  percent      Decimal? @db.Decimal(5, 2)
  receivedAt   Decimal  @db.Decimal(12, 2)
  decidedById  String
  createdAt    DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model LedgerEntry {
  id              String   @id @default(cuid())
  bookingOfficeId String
  memberId        String?
  caseId          String?
  paymentId       String?
  // Wave 21: optional admin attribution (e.g. department commission entries
  // credited against a specific admin). SetNull on admin delete.
  adminId         String?
  // COMMISSION_HALF | COMMISSION_FINAL | COMMISSION_ADJUST | EXTRA_SHARE | PROFIT_SHARE |
  // PAYOUT | ADJUSTMENT | DISCOUNT | BONUS | EXPENSE | DEPT_COMMISSION
  type            String
  // CREDIT | DEBIT
  direction       String
  amount          Decimal  @db.Decimal(12, 2)
  entryDate       DateTime
  method          String?
  remarks         String?
  createdById     String
  createdAt       DateTime @default(now())

  bookingOffice BookingOffice        @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  member        BookingOfficeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)
  case          Case?                @relation(fields: [caseId], references: [id], onDelete: SetNull)
  payment       Payment?             @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  admin         Admin?               @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([bookingOfficeId, entryDate])
  @@index([memberId])
  @@index([memberId, type, direction])
  @@index([caseId])
  @@index([entryDate])
  @@index([adminId])
}

model SalaryEntry {
  id              String    @id @default(cuid())
  bookingOfficeId String
  memberId        String?
  amount          Decimal   @db.Decimal(12, 2)
  // YYYY-MM
  periodMonth     String
  paidDate        DateTime?
  remarks         String?
  createdById     String
  createdAt       DateTime  @default(now())

  bookingOffice BookingOffice        @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  member        BookingOfficeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([bookingOfficeId, periodMonth])
  @@index([paidDate])
}

model CompanyExpense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  description String
  category    String?
  expenseDate DateTime
  // §W51: department user ka "Other expense" (kisi case se nahi — sirf admin ke
  // profit se minus). Jis ne jeb se diya; admin ne wapas dena hai
  // (DeptPayoutRequest OTHER_EXPENSE). null = company ka aam kharcha.
  paidByAdminId String?
  createdById String
  createdAt   DateTime @default(now())

  @@index([expenseDate])
  @@index([paidByAdminId])
}

model WorkingDayCache {
  id                 String   @id @default(cuid())
  candidateDate      DateTime @unique
  workingDate        DateTime
  isCandidateWorking Boolean
  reason             String?
  // AI | FALLBACK | MANUAL
  source             String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model OfficeAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actorRole String
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Office wave 2 (docs/office-module/06_NEW_REQUIREMENTS.md): category sets,
// departments, holidays, remarks, discounts/bonuses, expenses, links.
// ---------------------------------------------------------------------------

model CategorySet {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  order      Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category CaseCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  steps    CategorySetStep[]
  cases    Case[]

  @@unique([categoryId, name])
}

model CategorySetStep {
  id      String @id @default(cuid())
  setId   String
  // BOARD | UV_IBCC | QR_IBCC | SPECIAL_MOFA | SAUDI_EMBASSY | MOFA_SAUD | BACK_NAVTTC |
  // CURRENT_NAVTTC | BMFQ_VERIFICATION | MOH_ATTESTATION | CPLS_ATTESTATION | APAC_ATTESTATION | NAVTTC
  stepKey String
  label   String
  order   Float  @default(0)

  set CategorySet @relation(fields: [setId], references: [id], onDelete: Cascade)

  @@index([setId])
}

model HolidayClosure {
  id        String   @id @default(cuid())
  date      DateTime
  // PAKISTAN | ISLAMABAD | QUETTA | GUJRAT | LAHORE | EMBASSIES_ISB | SAUDI
  scope     String   @default("PAKISTAN")
  reason    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, scope])
}

// §W61 — har din (scope ke liye) ka ONLINE check: Tavily (ya GDELT) ki
// khabrein + attached AI ka faisla. Sirf kamyab AI faisla likha jata hai.
// Aane wali date (20 din ke andar) roz dobara check hoti hai.
model OfficeDayCheck {
  id        String   @id @default(cuid())
  date      DateTime
  // PAKISTAN | ISLAMABAD | QUETTA | GUJRAT | LAHORE | EMBASSIES_ISB | SAUDI
  scope     String
  open      Boolean
  reason    String?
  // [{ title, url }] — jin khabron par faisla hua
  sources   Json?
  // online khabrein mili thin? (false = sirf AI ka apna ilm)
  online    Boolean  @default(false)
  model     String?
  checkedAt DateTime @default(now())

  @@unique([date, scope])
}

// §W61 — dates ke online check ki settings (ek hi row "global").
model OfficeDateConfig {
  id           String   @id @default("global")
  tavilyApiKey String   @default("")
  updatedAt    DateTime @updatedAt
}

model WorkingDatePool {
  id        String   @id @default(cuid())
  year      Int
  date      DateTime
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([year, date])
}

model BoardAttestationCounter {
  id   String @id @default("global")
  last Int    @default(0)
}

model CaseFile {
  id           String   @id @default(cuid())
  caseId       String
  // FILING | PRINTING | ATTESTATION | COURIER
  department   String
  stepKey      String?
  fileKey      String
  fileType     String
  title        String?
  uploadedById String
  createdAt    DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@index([caseId, department])
  @@index([department])
}

model CaseRemark {
  id            String   @id @default(cuid())
  caseId        String
  text          String
  createdById   String
  createdByRole String
  createdAt     DateTime @default(now())

  case       Case                 @relation(fields: [caseId], references: [id], onDelete: Cascade)
  recipients CaseRemarkRecipient[]
  // §W32: "Remarks" tab — har user ne kaun se remarks Done kiye.
  dones      CaseRemarkDone[]

  @@index([caseId])
}

// §W32 — user ka apna "Done" (Remarks tab se hatana). Per user, per remark.
// §W35 — super admin ka per-case "Read" (navbar Cases tab ka unread count).
// `status` = read karte waqt case ka status. Case doosri queue (status) mein
// chala jaye to snapshot match nahi karta → case phir unread. Naye cases ki
// koi row nahi → unread.
model CaseRead {
  id      String   @id @default(cuid())
  caseId  String
  adminId String
  status  String
  readAt  DateTime @default(now())

  case  Case  @relation(fields: [caseId], references: [id], onDelete: Cascade)
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([caseId, adminId])
  @@index([adminId])
}

model CaseRemarkDone {
  id       String   @id @default(cuid())
  remarkId String
  adminId  String
  doneAt   DateTime @default(now())

  remark CaseRemark @relation(fields: [remarkId], references: [id], onDelete: Cascade)
  admin  Admin      @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@unique([remarkId, adminId])
  @@index([adminId])
}

model CaseRemarkRecipient {
  id       String    @id @default(cuid())
  remarkId String
  // ADMIN | BOOKING | FILING | PRINTING | ATTESTATION | COURIER
  target   String
  seenAt   DateTime?

  remark CaseRemark @relation(fields: [remarkId], references: [id], onDelete: Cascade)

  @@unique([remarkId, target])
  @@index([target, seenAt])
}

model DiscountRequest {
  id          String    @id @default(cuid())
  caseId      String
  amount      Decimal   @db.Decimal(12, 2)
  reason      String?
  // PENDING | ACCEPTED | REJECTED
  status      String    @default("PENDING")
  // COMMISSION | PROFIT | PARTIAL
  deductFrom  String?
  decidedById String?
  decidedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

model BonusRequest {
  id              String    @id @default(cuid())
  bookingOfficeId String
  caseId          String?
  amount          Decimal   @db.Decimal(12, 2)
  reason          String?
  // PENDING | ACCEPTED | REJECTED
  status          String    @default("PENDING")
  // COMMISSION | PROFIT
  deductFrom      String?
  decidedById     String?
  decidedAt       DateTime?
  createdById     String
  createdAt       DateTime  @default(now())

  bookingOffice BookingOffice @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  case          Case?         @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([bookingOfficeId])
  @@index([caseId])
}

model OfficeExpense {
  id              String   @id @default(cuid())
  bookingOfficeId String
  memberId        String?
  amount          Decimal  @db.Decimal(12, 2)
  description     String
  expenseDate     DateTime
  // Wave 21 (F5): FIXED_COMMISSION office ho aur flag on ho to expense active
  // members par profitPercent se split ho kar un ke commission ledger se
  // kat-ta hai (per-member EXPENSE DEBIT rows).
  deductFromCommission Boolean @default(false)
  // §W54: case delete par admin ne "kharcha usi office par rahe" chuna — department
  // user ka courier kharcha office ka kharcha ban gaya; user ka wapsi ka haq
  // (admin se wasooli) isi se. null = aam office kharcha.
  paidByAdminId   String?
  // §W55: us kharche ki qism — COURIER (user ka courier hisaab) | BYKEA (user ka
  // Other expenses hisaab). null + paidByAdminId = purana (courier).
  kind            String?
  createdById     String
  createdAt       DateTime @default(now())

  bookingOffice BookingOffice        @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  member        BookingOfficeMember? @relation(fields: [memberId], references: [id], onDelete: SetNull)

  @@index([bookingOfficeId])
  @@index([expenseDate])
  @@index([paidByAdminId])
}

model DepartmentLink {
  id         String   @id @default(cuid())
  // FILING | PRINTING | ATTESTATION | COURIER | ... (department key)
  department String
  label      String
  url        String
  order      Float    @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
}

// Wave 11 — instant notifications (bell + unread badge). Har office event par
// related users ko notification; 20s polling se bell live rehta hai.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user      Admin     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// Wave 14 — shareholder payout requests: admin/cashier request banata hai,
// system ka hissa tab banti hai jab office holder (member ka linked user)
// ACCEPT karta hai (us waqt PAYOUT ledger entry likhi jati hai).
model PayoutRequest {
  id              String    @id @default(cuid())
  bookingOfficeId String
  memberId        String
  amount          Decimal   @db.Decimal(12, 2)
  method          String    @default("CASH")
  entryDate       DateTime
  remarks         String?
  // PENDING | ACCEPTED | REJECTED
  status          String    @default("PENDING")
  ledgerEntryId   String?
  createdById     String
  decidedById     String?
  decidedAt       DateTime?
  createdAt       DateTime  @default(now())

  bookingOffice BookingOffice       @relation(fields: [bookingOfficeId], references: [id], onDelete: Cascade)
  member        BookingOfficeMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, status])
  @@index([bookingOfficeId, status])
}

// §W51 — department user (printing / attestation / courier) ko admin ki payment
// REQUEST: user accept kare tab paid. kind:
//   COMMISSION      — department commission (accept par PAYOUT DEBIT ledger row,
//                     adminId = user — pehle wala hisaab wahi)
//   COURIER_EXPENSE — courier kharche ki wapsi (CaseExpense.paidByAdminId)
//   OTHER_EXPENSE   — other kharche ki wapsi (CompanyExpense.paidByAdminId)
// Teeno alag alag pay hote hain; kharchon ki wapsi ledger mein nahi (expense
// pehle hi profit se minus hai — wapsi sirf qarz ada karti hai).
model DeptPayoutRequest {
  id            String    @id @default(cuid())
  adminId       String
  kind          String
  amount        Decimal   @db.Decimal(12, 2)
  method        String    @default("CASH")
  entryDate     DateTime
  remarks       String?
  // PENDING | ACCEPTED | REJECTED
  status        String    @default("PENDING")
  ledgerEntryId String?
  createdById   String
  decidedById   String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([adminId, status])
  @@index([status])
}

// §W52 — department user (printing / attestation / courier) ka bheja hua kharcha:
// admin ka REVIEW. PENDING ke dauran system mein kahin shumar nahi (na case
// expense, na shares / commission, na admin profit, na "admin se wasooli").
// Admin manzoor (ACCEPTED) kare to tab asal kharcha banta hai:
//   COURIER → us case ka CaseExpense (kind COURIER, paidByAdminId = user)
//   OTHER   → CompanyExpense (DEPT_OTHER, paidByAdminId = user)
// aur aage §W51 wala poora nizam. REJECTED = kuch nahi (wajah user ko).
model DeptExpenseRequest {
  id               String    @id @default(cuid())
  adminId          String
  // COURIER | BYKEA (dono case par) | OTHER (kisi case se nahi)
  kind             String
  caseId           String?
  // Case ki pehchan (case baad mein delete ho jaye tab bhi review mein nazar aaye).
  caseNumber       String?
  amount           Decimal   @db.Decimal(12, 2)
  description      String
  expenseDate      DateTime
  // PENDING | ACCEPTED | REJECTED
  status           String    @default("PENDING")
  // Admin ne manzoori par raqam badli ho to asal bheji hui raqam yahan.
  requestedAmount  Decimal?  @db.Decimal(12, 2)
  decisionNote     String?
  decidedById      String?
  decidedAt        DateTime?
  caseExpenseId    String?
  companyExpenseId String?
  createdAt        DateTime  @default(now())

  @@index([status, createdAt])
  @@index([adminId, status])
  @@index([caseId])
}
